# Base URL of the Nivaran API (the Express server). Leave empty to call the same origin.
# The server's CORS allow-list (CLIENT_URL) must include this app's origin.
VITE_API_URL=http://localhost:5000

# Auth0 (Phase 1). Create the tenant first: docs/AUTH0_SETUP.md. These are public values, not secrets.
# Leave all three empty and the app runs without sign-in (no Sign in button, protected pages say so).
# Tenant host only, no https:// (e.g. nivaran.eu.auth0.com)
VITE_AUTH0_DOMAIN=
# Client ID of the Single Page Application in Auth0
VITE_AUTH0_CLIENT_ID=
# The API identifier (must equal AUTH0_AUDIENCE in server/.env)
VITE_AUTH0_AUDIENCE=

# Optional. Who a suspended user should contact ("Contact {contact} ..."). Default: "your city admin".
VITE_SUPPORT_CONTACT=
