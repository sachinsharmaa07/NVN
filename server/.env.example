# Copy this file to server/.env and fill in the values. Never commit .env.

# development | test | production (default: development)
NODE_ENV=development

# Port the API listens on (default: 5001)
PORT=5001

# MongoDB connection string for the app, database nivaran_dev. Required except when NODE_ENV=test.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nivaran_dev
MONGODB_URI=

# Separate MongoDB database for tests. Tests may WIPE it, so its name must end in _test
# (e.g. nivaran_test) and it must differ from MONGODB_URI. Leave empty to skip DB tests.
MONGODB_URI_TEST=

# The front end's origin; the only origin CORS allows (default: http://localhost:5173; required in production)
CLIENT_URL=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# Number of proxies in front of the API: 0 locally, usually 1 on Render or behind Nginx (required in production)
TRUST_PROXY=0

# Auth0 (Phase 1). Create the tenant first: docs/AUTH0_SETUP.md. Not secrets, but keep them out of git anyway.
# Tenant host only, no https:// (e.g. nivaran.eu.auth0.com). Required in production.
AUTH0_DOMAIN=
# The API identifier from Auth0 (e.g. https://api.nivaran.in). Required in production.
AUTH0_AUDIENCE=

# Clock skew allowed when checking token expiry, in seconds (default 5, max 30). Keep hosts on NTP.
AUTH_CLOCK_TOLERANCE_SECONDS=5
# Auth0 Machine-to-Machine app (Management API). Authorize it with ONLY update:users and
# update:users_app_metadata. Server only, never in client/.env. Required in production.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
# Email of the first super admin. Read only by `npm run bootstrap:super-admin -w server`, which
# refuses unless this person has signed in once and verified the email.
SUPER_ADMIN_EMAIL=

# Waitlist email HMAC key (decision O1). Generate once with: openssl rand -hex 32
# Server only. Changing it orphans every stored waitlist hash. Required in production.
HMAC_SECRET=
