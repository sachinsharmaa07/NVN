# Dependencies
node_modules/

# Environment files (secrets) - keep only the template
.env*
!.env.example

# Other credential files (registry tokens, keys, cloud service accounts)
.npmrc
*.pem
*.key
*service-account*.json

# Build output and tool caches
dist/
.vite/

# Test output
coverage/
playwright-report/
test-results/
.playwright-mcp/

# Logs
*.log
logs/

# OS files
.DS_Store

# Cleanup holding area (untracked files waiting for deletion)
_to_delete/

# Claude Code personal overrides
.claude/settings.local.json

# Graphify knowledge graph (regenerate with: graphify extract . --code-only)
graphify-out/

# National pincode CSV from data.gov.in: over 10 MB, download it (see README "Pincode data")
data/pincodes.csv
